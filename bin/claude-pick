#!/usr/bin/env python3
"""Rofi launcher for Claude Code: pick a folder, then a session, in a new terminal.

First list: ~ (system, the default), the folders Claude has already worked in
(most recent first, each with how full the context of its last session is),
then the other folders of the projects folder (~/Zeke_projects, or CLAUDE_PROJECTS_DIR), then
"Other folder...".
Second list: that folder's sessions. The session opens in a new window of your terminal
(alacritty, wezterm, kitty, foot, terminator or xterm; see CLAUDE_TERMINAL). The context percentage is the size of the
prompt in the session's last reply (input + cache tokens) over the window; from
REFRESH_AT percent it suggests a new session, with a handoff message that makes
Claude read the project docs and say where we were.

Sessions are started through claude-new (names, numbering). Before any session, claude-fresh
brings the project up to date from GitHub when it is only behind and clean; the first list marks
each folder with ↑ (commits not pushed), ✎ (uncommitted files) and ↓ (behind, as last fetched). Window size: the
number in ~/.config/claude-pick/window (default 200000); a session that is
already above it means the window is bigger, and 1000000 is assumed.

Console mode (no screen, no rofi): the same lists as numbered menus in the terminal you are in,
and the session starts in that same terminal. It is what `claudio` runs, and claude-pick falls
back to it by itself when there is no display (a TTY, ssh) or no rofi.

Usage: claude-pick            open the launcher (rofi, or the console menus without a display)
       claude-pick --console  force the console menus (same as `claudio`)
       claude-pick --list     print the first list as text (no rofi)
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from html import escape
from pathlib import Path

# the library sits next to bin/ in the repo, whether the script is run through a symlink or not
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "claude-tools"))
import gitfresh  # noqa: E402

HOME = Path.home()
# A key bound in a window manager starts with a minimal PATH, and claude and the other
# tools live in ~/.local/bin: put it first, for this program and for what it starts.
_LOCAL_BIN = str(HOME / ".local" / "bin")
if _LOCAL_BIN not in os.environ.get("PATH", "").split(":"):
    os.environ["PATH"] = _LOCAL_BIN + ":" + os.environ.get("PATH", "")
PROJECTS = Path(os.environ.get("CLAUDE_PICK_STORE", HOME / ".claude" / "projects"))
CODE = gitfresh.PROJECTS_DIR             # CLAUDE_PROJECTS_DIR, default ~/Zeke_projects
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "claude-pick" / "cache.json"
WINDOW_FILE = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "claude-pick" / "window"
DEFAULT_WINDOW = 200_000
BIG_WINDOW = 1_000_000
WARN_AT, REFRESH_AT = 35, 50          # percent of the window
GREEN, YELLOW, RED, DIM = "#a6e3a1", "#f9e2af", "#f38ba8", "#6c7086"   # Catppuccin Mocha
BLUE = "#89b4fa"                      # git badges: ↑ not pushed, ✎ uncommitted, ↓ behind

# The docs hold what was written down; git shows what was changed and not committed yet.
# In ~ the project is the home project (by default the dotfiles repo, ~/dotfiles).
_HOME_PROJECT = str(gitfresh.HOME_PROJECT).replace(str(HOME), "~", 1)
HANDOFF = ("This is a new session to continue the work of the previous one. Read the "
           "project's state docs (docs/STATE.md, including its 'In progress' section, "
           "docs/CHANGELOG.md and docs/DECISIONS.md, if they exist; in ~ they are in "
           f"{_HOME_PROJECT}/docs), and run git status -sb (it shows commits not pushed) and "
           f"git log --oneline -8 in the project (in ~, in {_HOME_PROJECT}). Tell me in a few "
           "lines where we were, what is uncommitted and what is pending, and ask me if the "
           "docs look behind. Do not change anything yet.")


# ---- reading sessions -------------------------------------------------------

def window_size():
    try:
        return int(WINDOW_FILE.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return DEFAULT_WINDOW


def last_context(path, size):
    """Tokens in the prompt of the last real assistant reply, read from the end of the file."""
    chunk = 256 * 1024
    with open(path, "rb") as f:
        while True:
            start = max(0, size - chunk)
            f.seek(start)
            lines = f.read(size - start).split(b"\n")
            if start > 0:
                lines = lines[1:]          # first line may be cut
            for line in reversed(lines):
                if b'"type":"assistant"' not in line or b'"usage"' not in line:
                    continue
                try:
                    msg = json.loads(line).get("message") or {}
                except ValueError:
                    continue
                usage = msg.get("usage") or {}
                if msg.get("model") == "<synthetic>":
                    continue
                total = (usage.get("input_tokens", 0) + usage.get("cache_read_input_tokens", 0)
                         + usage.get("cache_creation_input_tokens", 0))
                if total:
                    return total
            if start == 0:
                return 0
            chunk *= 4


def scan(path):
    """Everything claude-pick needs from one session file (cached by mtime and size)."""
    st = path.stat()
    key = str(path)
    cache = scan.cache
    hit = cache.get(key)
    if hit and hit[0] == st.st_mtime_ns and hit[1] == st.st_size:
        return hit[2]
    title = ai_title = cwd = ""
    replies = 0
    with open(path, "rb") as f:
        for line in f:
            if b'"type":"assistant"' in line:
                replies += 1
            elif b'"customTitle"' in line:
                try:
                    title = json.loads(line).get("customTitle") or title
                except ValueError:
                    pass
            elif b'"aiTitle"' in line:
                try:
                    ai_title = json.loads(line).get("aiTitle") or ai_title
                except ValueError:
                    pass
            if not cwd and b'"cwd"' in line:
                try:
                    cwd = json.loads(line).get("cwd") or ""
                except ValueError:
                    pass
    info = {"title": title or ai_title or path.stem[:8], "cwd": cwd, "replies": replies,
            "ctx": last_context(path, st.st_size) if st.st_size else 0}
    cache[key] = [st.st_mtime_ns, st.st_size, info]
    scan.dirty = True
    return info


scan.cache, scan.dirty = {}, False


def load_cache():
    try:
        scan.cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        scan.cache = {}


def save_cache():
    if not scan.dirty:
        return
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(scan.cache))
    except OSError:
        pass


def sessions_by_folder(store=None):
    """{folder: [session dicts, newest first]} for every folder Claude has worked in."""
    found = {}
    for f in (store or PROJECTS).glob("*/*.jsonl"):
        try:
            info = dict(scan(f))
            st = f.stat()
        except OSError:
            continue
        cwd = info["cwd"]
        if not cwd or not os.path.isdir(cwd):
            continue
        rel = os.path.relpath(cwd, HOME)
        if rel.startswith("..") or any(p.startswith(".") for p in Path(rel).parts):
            continue                       # outside ~, or hidden (headless helper sessions)
        info.update(id=f.stem, mtime=st.st_mtime, size=st.st_size)
        found.setdefault(cwd, []).append(info)
    for lst in found.values():
        lst.sort(key=lambda s: s["mtime"], reverse=True)
    return found


# ---- formatting -------------------------------------------------------------

def percent(ctx, window=None):
    window = window or window_size()
    if ctx > window:
        window = max(window, BIG_WINDOW)
    return round(100 * ctx / window)


def colour(pct):
    return RED if pct >= REFRESH_AT else YELLOW if pct >= WARN_AT else GREEN


def ago(ts, now=None):
    s = (now or time.time()) - ts
    if s < 3600:
        return f"{max(1, int(s // 60))} min ago"
    if s < 86400:
        return f"{int(s // 3600)} h ago"
    if s < 2 * 86400:
        return "yesterday"
    return f"{int(s // 86400)} d ago"


def mib(n):
    return f"{n / 1048576:.0f} MB" if n >= 1048576 else f"{max(1, n // 1024)} KB"


def folder_label(path):
    return "~  System (home)" if Path(path) == HOME else "~/" + os.path.relpath(path, HOME)


def stats(s, window=None):
    pct = percent(s["ctx"], window)
    return pct, f"{pct:>3}%  {s['replies']:>5} replies  {mib(s['size']):>6}  {ago(s['mtime'])}"


def mono(text):
    return f"<span font_family='monospace'>{text}</span>"


def folder_rows(found=None, window=None):
    """[(folder or None for 'other', markup, plain)] for the first list."""
    found = found if found is not None else sessions_by_folder()
    folders = [str(HOME)] + [d for d in sorted(found, key=lambda d: -found[d][0]["mtime"])
                             if Path(d) != HOME]
    if CODE.is_dir():
        folders += [str(p) for p in sorted(CODE.iterdir())
                    if p.is_dir() and not p.name.startswith(".") and str(p) not in folders]
    rows = []
    for d in folders:
        label = folder_label(d)
        if d in found:
            pct, text = stats(found[d][0], window)
            mark = " <span foreground='%s'>refresh?</span>" % RED if pct >= REFRESH_AT else ""
            markup = (f"<span foreground='{colour(pct)}'>●</span> {escape(label):<34} "
                      f"<span foreground='{DIM}'>{escape(text)}</span>{mark}")
            plain = f"{label:<34} {text}" + ("  refresh?" if pct >= REFRESH_AT else "")
        else:
            markup = f"<span foreground='{DIM}'>○</span> {escape(label):<34} <span foreground='{DIM}'>no sessions yet</span>"
            plain = f"{label:<34} no sessions yet"
        git_marks = gitfresh.badges(gitfresh.state(d))
        if git_marks:
            markup += f"  <span foreground='{BLUE}'>{escape(git_marks)}</span>"
            plain += f"  {git_marks}"
        rows.append((d, mono(markup), plain))
    rows.append((None, mono("＋ Other folder…"), "Other folder…"))
    return rows


def session_rows(sessions, window=None):
    """[(action, session or None, markup, plain)] for a folder that already has sessions.
    actions: new, handoff, resume"""
    last = sessions[0]
    pct, _ = stats(last, window)
    refresh = pct >= REFRESH_AT
    new = ("new", None, "New session (empty)", "New session (empty)")
    hand = ("handoff", None, "New session with handoff (reads the docs)" +
            (f"  ← recommended, context at {pct}%" if refresh else ""),
            "New session with handoff")
    rows = []
    cont = lambda s, first: ("resume", s, *[(("Continue: " if first else "") + s["title"])] * 2)
    if refresh:
        rows += [hand, new]
    rows += [cont(last, True)]
    if not refresh:
        rows += [new, hand]
    rows += [cont(s, False) for s in sessions[1:]]
    out = []
    for action, s, markup, plain in rows:
        if s is not None:
            p, text = stats(s, window)
            markup = (f"<span foreground='{colour(p)}'>●</span> {escape(markup):<44} "
                      f"<span foreground='{DIM}'>{escape(text)}</span>")
            plain = f"{plain:<44} {text}"
        else:
            markup = f"<span foreground='{RED if refresh and action == 'handoff' else '#cdd6f4'}'>{escape(markup)}</span>"
        out.append((action, s, mono(markup), plain))
    return out


# ---- rofi and launching -----------------------------------------------------

def rofi(prompt, markups, mesg=None):
    """Index of the chosen row, or None if cancelled."""
    cmd = ["rofi", "-dmenu", "-i", "-markup-rows", "-matching", "fuzzy", "-format", "i",
           "-p", prompt, "-no-custom"]
    if mesg:
        cmd += ["-mesg", mesg]
    res = subprocess.run(cmd, input="\n".join(markups), text=True, capture_output=True)
    try:
        return int(res.stdout.strip()) if res.returncode == 0 else None
    except ValueError:
        return None


def browse(start):
    """Walk the folder tree in rofi; returns the chosen folder or None."""
    cur = Path(start)
    while True:
        subs = sorted(p for p in cur.iterdir() if p.is_dir() and not p.name.startswith(".")) \
            if cur.is_dir() else []
        entries = [("use", cur), ("up", cur.parent)] + [("down", p) for p in subs]
        labels = ["✔  Use this folder", "..  (up)"] + [f"›  {p.name}" for p in subs]
        i = rofi(str(cur).replace(str(HOME), "~", 1), [escape(x) for x in labels])
        if i is None:
            return None
        kind, path = entries[i]
        if kind == "use":
            return str(cur)
        cur = path


# How to open a command in a new window of each terminal, in the order they are tried
# when none is chosen: name -> function(folder, title, command) -> argv.
TERMINALS = {
    "alacritty": lambda d, t, c: ["alacritty", "--class", "claude-session", "-T", t,
                                  "--working-directory", d, "-e", *c],
    "wezterm": lambda d, t, c: ["wezterm", "start", "--class", "claude-session", "--cwd", d, "--", *c],
    "kitty": lambda d, t, c: ["kitty", "--class", "claude-session", "--title", t, "--directory", d, *c],
    "foot": lambda d, t, c: ["foot", "--app-id", "claude-session", "--title", t,
                             "--working-directory", d, *c],
    "terminator": lambda d, t, c: ["terminator", f"--title={t}", f"--working-directory={d}", "-x", *c],
    "xterm": lambda d, t, c: ["xterm", "-class", "claude-session", "-T", t, "-e", *c],
}


def choose_terminal():
    """CLAUDE_TERMINAL, or the `terminal` file of ~/.config/claude-tools, or the first
    installed terminal of TERMINALS; None if there is none."""
    chosen = os.environ.get("CLAUDE_TERMINAL") or gitfresh.config_value("terminal")
    if chosen:
        return chosen
    return next((t for t in TERMINALS if shutil.which(t)), None)


def terminal_argv(terminal, folder, title, command):
    if terminal in TERMINALS:
        return TERMINALS[terminal](folder, title, command)
    return [terminal, "-e", *command]          # any other terminal that accepts -e


def session_command(folder, action, session=None):
    """The command that starts the chosen session (the same for the rofi and the console mode)."""
    if action == "resume":
        # claude-new does the update check for new sessions; a resumed one needs it here
        return ["bash", "-c", 'claude-fresh "$1" || read -r -p "Enter to go on, Ctrl+C to stop: " _; '
                              'exec claude -r "$2"', "claude-pick", folder, session["id"]]
    return ["claude-new", "--new", folder] + ([HANDOFF] if action == "handoff" else [])


def launch(folder, action, session=None):
    name = Path(folder).name if Path(folder) != HOME else "home"
    inner = session_command(folder, action, session)
    terminal = choose_terminal()
    if terminal is None:
        sys.exit("claude-pick: no terminal found (tried " + ", ".join(TERMINALS) +
                 "); set CLAUDE_TERMINAL or ~/.config/claude-tools/terminal")
    subprocess.Popen(terminal_argv(terminal, folder, f"Claude · {name}", inner), cwd=folder,
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- console mode ------------------------------------------------------------

ANSI = {GREEN: "32", YELLOW: "33", RED: "31", DIM: "90"}


def colour_line(plain, use_colour):
    """Colour the context percentage of a row like the dot of the rofi list."""
    if not use_colour:
        return plain
    m = re.search(r"(?<=\s)(\d{1,3})%", plain)
    if not m:
        return plain
    code = ANSI[colour(int(m.group(1)))]
    return plain[:m.start()] + f"\033[{code}m{m.group(0)}\033[0m" + plain[m.end():]


def console_menu(title, plains, ask=input, out=print, width=100, use_colour=False):
    """A numbered menu. A number picks a row, text filters the rows, Enter picks the first one
    shown, "/" shows all again, q or Ctrl+D leaves. Returns an index of plains, or None."""
    shown = list(range(len(plains)))
    while True:
        out(f"\n{title}")
        for n, i in enumerate(shown, 1):
            out(f"{n:>3}  " + colour_line(plains[i][:max(20, width - 6)], use_colour))
        try:
            ans = ask("number, text to filter, Enter = 1, q = quit > ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if ans == "":
            return shown[0]
        if ans.lower() in ("q", "quit"):
            return None
        if ans == "/":
            shown = list(range(len(plains)))
        elif ans.isdigit():
            if 1 <= int(ans) <= len(shown):
                return shown[int(ans) - 1]
            out(f"no row {ans}")
        else:
            hit = [i for i in range(len(plains)) if ans.lower() in plains[i].lower()]
            if hit:
                shown = hit
            else:
                out(f"nothing matches '{ans}'")


def browse_console(ask=input, out=print):
    """Ask for a folder, with Tab completion of paths; returns the folder or None."""
    try:
        import readline
        readline.set_completer_delims(" \t\n")

        def complete(text, state):
            base = os.path.expanduser(text)
            head, tail = os.path.split(base)
            try:
                names = sorted(n for n in os.listdir(head or ".") if n.startswith(tail)
                               and os.path.isdir(os.path.join(head, n)))
            except OSError:
                names = []
            matches = [os.path.join(head, n) + "/" for n in names]
            return matches[state] if state < len(matches) else None

        readline.set_completer(complete)
        readline.parse_and_bind("tab: complete")
    except ImportError:
        pass
    while True:
        try:
            ans = ask("folder (Tab completes, Enter = ~, q = back) > ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if ans.lower() == "q":
            return None
        folder = os.path.abspath(os.path.expanduser(ans or "~"))
        if os.path.isdir(folder):
            return folder
        out(f"not a folder: {folder}")


def have_display():
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def run_console(found, ask=input, out=print, execute=os.execvp):
    """The two menus in the terminal, then the session starts in this same terminal."""
    if not sys.stdin.isatty() and ask is input:
        sys.exit("claudio: it needs a terminal to ask in (run it from a shell)")
    width = shutil.get_terminal_size((100, 24)).columns
    use_colour = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    rows = folder_rows(found)
    legend = (f"green <{WARN_AT}%, yellow <{REFRESH_AT}%, red = start a new session "
              f"(context of the last one)   ↑ not pushed  ✎ uncommitted  ↓ behind")
    i = console_menu("Claude · pick a folder\n" + legend, [p for _, _, p in rows], ask, out, width, use_colour)
    if i is None:
        return
    folder = rows[i][0]
    if folder is None:
        folder = browse_console(ask, out)
        if folder is None:
            return
    sessions = found.get(folder)
    if sessions:
        srows = session_rows(sessions)
        title = "home" if Path(folder) == HOME else Path(folder).name
        j = console_menu(f"{title} · pick a session", [p for _, _, _, p in srows], ask, out, width, use_colour)
        if j is None:
            return
        action, session = srows[j][0], srows[j][1]
    else:
        action, session = "new", None
    os.chdir(folder)
    cmd = session_command(folder, action, session)
    execute(cmd[0], cmd)


def main():
    load_cache()
    found = sessions_by_folder()
    save_cache()
    if "--list" in sys.argv:
        for _, _, plain in folder_rows(found):
            print(plain)
        return
    if "--console" in sys.argv or not have_display() or not shutil.which("rofi"):
        run_console(found)
        return
    rows = folder_rows(found)
    i = rofi("Claude", [m for _, m, _ in rows],
             mesg=f"● context of the last session: green &lt;{WARN_AT}%, yellow &lt;{REFRESH_AT}%, "
                  f"red = start a new one   ·   ↑ not pushed  ✎ uncommitted  ↓ behind")
    if i is None:
        return
    folder = rows[i][0]
    if folder is None:
        folder = browse(HOME)
        if folder is None:
            return
    sessions = found.get(folder)
    if not sessions:
        launch(folder, "new")
        return
    srows = session_rows(sessions)
    j = rofi("home" if Path(folder) == HOME else Path(folder).name, [m for _, _, m, _ in srows])
    if j is not None:
        launch(folder, srows[j][0], srows[j][1])


if __name__ == "__main__":
    main()
