#!/usr/bin/env python3
"""Bring a project up to date with what the other computer pushed, before Claude works on it.

Runs a short `git fetch` and, if the project is only behind and has no uncommitted
changes, `git pull --ff-only`. Otherwise it only says what it found. It never merges,
forces or pushes. In ~ it works on the home project (~/dotfiles by default) and on
this tool's own repo. Used by claude-new and claude-pick.

Usage: claude-fresh [folder]     exit 0 = fine or nothing to do, 2 = needs a look
"""
import os
import sys

from pathlib import Path

# the library sits next to bin/ in the repo, whether the script is run through a symlink or not
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "claude-tools"))
import gitfresh  # noqa: E402


def main():
    folder = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
    if gitfresh.state(folder) is None:
        return 0
    print("Checking for updates… ", end="", flush=True)
    status, msg = gitfresh.freshen(folder)
    print(msg)
    return 2 if status in gitfresh.ATTENTION else 0


if __name__ == "__main__":
    sys.exit(main())
